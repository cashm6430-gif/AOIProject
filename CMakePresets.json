{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_POLICY_DEFAULT_CMP0091": "NEW"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/debug/build/Debug/generators/conan_toolchain.cmake"
      }
    },
    {
      "name": "relwithdebuginfo",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/relwithdebuginfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/release/build/Release/generators/conan_toolchain.cmake"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/out/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/release/build/Release/generators/conan_toolchain.cmake"
      }
    },
    {
      "name": "vs2022-release",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/out/build/vs2022-release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/out/conan/vs2022-release/build/generators/conan_toolchain.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-debug",
      "configurePreset": "debug"
    },
    {
      "name": "build-relwithdebuginfo",
      "configurePreset": "relwithdebuginfo"
    },
    {
      "name": "build-release",
      "configurePreset": "release"
    },
    {
      "name": "build-vs2022-release",
      "configurePreset": "vs2022-release",
      "configuration": "Release"
    }
  ]
}
